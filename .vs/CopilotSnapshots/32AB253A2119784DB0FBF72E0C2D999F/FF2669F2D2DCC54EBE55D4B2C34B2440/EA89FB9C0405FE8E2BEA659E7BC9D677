<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>QuestBypasser</AssemblyName>
		<RootNamespace>QuestBypasser</RootNamespace>
		<Version>1.0.0</Version>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- Prevent generation of unnecessary files -->
		<GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>

		<!-- Dynamically uses local VibeSkua assemblies without hardcoding usernames -->
		<SkuaAssemblies>$(UserProfile)\AppData\Local\VibeSkua\current\Assemblies</SkuaAssemblies>

		<!-- Temporary output path -->
		<OutputPath>$(ProjectDir)bin\Release\</OutputPath>
	</PropertyGroup>

	<!-- Post-build event: Copy only the DLL to Skua plugins folder -->
	<Target Name="CopyDllToSkuaPlugins" AfterTargets="Build">
		<Copy SourceFiles="$(OutputPath)QuestBypasser.dll" DestinationFolder="$(APPDATA)\Skua\Plugins\" />
		<Message Text="Copied QuestBypasser.dll to $(APPDATA)\Skua\Plugins\" Importance="high" />
	</Target>

	<!-- Clean up all files in output directory except DLL - optional, for keeping build clean -->
	<Target Name="CleanBuildArtifacts" AfterTargets="CopyDllToSkuaPlugins">
		<ItemGroup>
			<FilesToDelete Include="$(OutputPath)*" Exclude="$(OutputPath)QuestBypasser.dll" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
		<Message Text="Cleaned up unnecessary build artifacts from output directory" Importance="normal" />
	</Target>

	<!-- Required NuGet Packages -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<!-- Skua Assembly References -->
	<ItemGroup>
		<Reference Include="Skua.Core.Interfaces">
			<HintPath>$(SkuaAssemblies)\Skua.Core.Interfaces.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Skua.Core.Models">
			<HintPath>$(SkuaAssemblies)\Skua.Core.Models.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Skua.Core.Utils">
			<HintPath>$(SkuaAssemblies)\Skua.Core.Utils.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Skua.Core">
			<HintPath>$(SkuaAssemblies)\Skua.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Skua.WPF">
			<HintPath>$(SkuaAssemblies)\Skua.WPF.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>