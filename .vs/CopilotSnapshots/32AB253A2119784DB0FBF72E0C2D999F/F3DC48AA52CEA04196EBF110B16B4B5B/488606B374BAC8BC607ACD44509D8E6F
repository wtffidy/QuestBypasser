using System;
using System.Linq;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using Skua.Core.Interfaces;
using Skua.Core.Interfaces.Services;

namespace QuestBypasser
{
    public partial class MainPluginView : UserControl
    {
        private readonly IScriptInterface _bot;

        public MainPluginView(IScriptInterface bot)
        {
            InitializeComponent();
            _bot = bot;
        }

        private async void BtnReload_Click(object sender, RoutedEventArgs e)
        {
            BtnReload.IsEnabled = false;
            TxtStatus.Text = "Status: Executing...";

            try
            {
                await Task.Run(async () =>
                {
                    if (!_bot.Player.LoggedIn || !_bot.Map.Loaded)
                    {
                        UpdateStatus("Status: Player or Map not loaded.");
                        return;
                    }

                    var mapQuests = _bot.Quests.Tree;
                    if (mapQuests == null || mapQuests.Count == 0)
                    {
                        UpdateStatus("Status: No map quests found.");
                        return;
                    }

                    int lastQuestId = mapQuests.Max(q => q.ID);

                    _bot.Log($"Updating Quest ID: {lastQuestId}");
                    _bot.Quests.UpdateQuest(lastQuestId);

                    await Task.Delay(1500);

                    _bot.Log("Reloading map...");
                    _bot.Map.Reload();

                    _bot.Wait.ForMapLoad(_bot.Map.Name);
                    _bot.Wait.ForTrue(() => _bot.Player.Loaded, 30);

                    UpdateStatus($"Status: Updated Quest #{lastQuestId} & Reloaded");
                });
            }
            catch (Exception ex)
            {
                UpdateStatus($"Error: {ex.Message}");
            }
            finally
            {
                BtnReload.IsEnabled = true;
            }
        }

        private void UpdateStatus(string message)
        {
            Application.Current.Dispatcher.Invoke(() =>
            {
                TxtStatus.Text = message;
            });
        }
    }
}